.student-task-page {
    padding-top: 20rpx;
}

.pet-summary {
    display: flex;
    gap: 20rpx;
}

.pet-summary-img {
    width: 132rpx;
    height: 132rpx;
    flex-shrink: 0;
    border-radius: 27rpx;
}

.pet-name {
    font-size: 30rpx;
    font-weight: 900;
}

.pet-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8rpx;
    margin-top: 9rpx;
}

.pet-tag {
    padding: 3rpx 11rpx;
    border-radius: 8rpx;
    color: #b45309;
    background: #fffbeb;
    font-size: 18rpx;
}

.pet-note {
    margin-top: 10rpx;
    line-height: 1.5;
}

.task-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14rpx;
    margin-top: 20rpx;
}

.fact {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    padding: 20rpx;
    border-radius: 22rpx;
    background: #ffffff;
    border: 1rpx solid rgba(229, 231, 235, 0.7);
}

.fact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38rpx;
    height: 38rpx;
    flex-shrink: 0;
    border-radius: 12rpx;
    color: #0d9488;
    background: #f0fdfa;
    font-size: 20rpx;
}

.fact-value {
    margin-top: 4rpx;
    font-size: 23rpx;
    line-height: 1.35;
}

.checklist-card {
    margin-top: 20rpx;
}

.check-item {
    display: flex;
    align-items: center;
    gap: 11rpx;
    padding: 8rpx 0;
    color: #374151;
    font-size: 24rpx;
}

.check-mark {
    color: #0d9488;
    font-weight: 800;
}

.task-note {
    margin-top: 14rpx;
    padding: 18rpx;
    border-radius: 16rpx;
    color: #6b7280;
    background: #f7f5f2;
    font-size: 22rpx;
    line-height: 1.55;
}

.privacy-note {
    display: flex;
    align-items: flex-start;
    gap: 9rpx;
    margin: 22rpx 4rpx;
    color: #6b7280;
    font-size: 21rpx;
    line-height: 1.5;
}

.privacy-icon {
    color: #0d9488;
}

.quote-card {
    margin-top: 10rpx;
}

.quote-head {
    align-items: flex-start;
}

.quote-label {
    margin-bottom: 5rpx;
}

.deadline-badge {
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    color: #c2410c;
    background: #fff7ed;
    font-size: 20rpx;
    font-weight: 700;
}

.price-editor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28rpx;
    margin: 28rpx 0 22rpx;
}

.price-step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68rpx;
    height: 68rpx;
    border-radius: 50%;
    color: #ea580c;
    background: #fff7ed;
    font-size: 36rpx;
    font-weight: 700;
}

.price-input-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    min-width: 220rpx;
    padding: 10rpx 20rpx;
    border-bottom: 3rpx solid #fb923c;
}

.price-yen {
    color: #ea580c;
    font-size: 31rpx;
    font-weight: 800;
}

.price-input {
    width: 160rpx;
    height: 74rpx;
    color: #ea580c;
    font-size: 55rpx;
    font-weight: 900;
    text-align: center;
}

.earnings-row {
    display: flex;
    align-items: center;
    padding: 18rpx 12rpx;
    border-radius: 18rpx;
    background: #f7f5f2;
}

.earning-cell {
    flex: 1;
    text-align: center;
}

.earning-value {
    margin-top: 5rpx;
    font-size: 27rpx;
    font-weight: 800;
}

.receive {
    color: #0d9488;
}

.earning-divider {
    width: 1rpx;
    height: 44rpx;
    background: #e5e7eb;
}

.message-label {
    margin: 28rpx 0 12rpx;
    font-size: 24rpx;
    font-weight: 700;
}

.message-input {
    min-height: 125rpx;
}

.quote-submit {
    margin-top: 24rpx;
}

.quote-rule {
    margin-top: 13rpx;
    line-height: 1.5;
    text-align: center;
}

.done-card {
    margin-top: 10rpx;
    text-align: center;
}

.done-title {
    font-size: 30rpx;
    font-weight: 900;
}

.done-desc {
    margin-top: 12rpx;
    line-height: 1.55;
}

.done-button {
    margin-top: 20rpx;
    min-height: 76rpx;
    font-size: 25rpx;
}
