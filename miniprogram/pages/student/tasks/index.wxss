.student-tasks-page {
    padding-top: 22rpx;
}

.filter-row {
    display: flex;
    gap: 15rpx;
    padding-bottom: 24rpx;
}

.filter-chip {
    min-width: 130rpx;
    text-align: center;
}

.task-list {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.student-task-card {
    padding: 24rpx;
}

.task-head {
    align-items: flex-start;
}

.task-name-row {
    gap: 16rpx;
}

.task-pet {
    width: 84rpx;
    height: 84rpx;
    border-radius: 20rpx;
}

.task-time {
    margin-top: 5rpx;
}

.task-progress {
    display: flex;
    align-items: center;
    gap: 10rpx;
    margin-top: 20rpx;
    padding: 16rpx 18rpx;
    border-radius: 16rpx;
    background: #f7f5f2;
}

.progress-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #14b8a6;
}

.progress-arrow {
    margin-left: auto;
    color: #9ca3af;
    font-size: 30rpx;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 140rpx;
}

.empty-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140rpx;
    height: 140rpx;
    margin-bottom: 22rpx;
    border-radius: 50%;
    background: #ffffff;
    font-size: 58rpx;
}

.empty-text {
    margin-top: 9rpx;
}

.go-hall {
    width: 320rpx;
    margin-top: 30rpx;
}
