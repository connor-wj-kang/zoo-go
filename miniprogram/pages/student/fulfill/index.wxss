.fulfill-page {
    padding-top: 20rpx;
}

.fulfill-hero {
    padding: 32rpx;
    border-radius: 34rpx;
    color: #ffffff;
    background: linear-gradient(125deg, #0f766e, #14b8a6);
    box-shadow: 0 17rpx 38rpx rgba(13, 148, 136, 0.22);
}

.fulfill-kicker {
    color: rgba(255, 255, 255, 0.72);
    font-size: 21rpx;
}

.fulfill-title {
    margin-top: 7rpx;
    font-size: 37rpx;
    font-weight: 900;
}

.fulfill-time,
.fulfill-address {
    margin-top: 12rpx;
    color: rgba(255, 255, 255, 0.88);
    font-size: 23rpx;
}

.fulfill-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
}

.hero-action {
    flex: 1;
    padding: 17rpx;
    border-radius: 18rpx;
    background: rgba(255, 255, 255, 0.14);
    text-align: center;
    font-size: 23rpx;
    font-weight: 600;
}

.checklist-card {
    margin-top: 20rpx;
}

.checklist-title {
    margin-bottom: 8rpx;
}

.check-row {
    display: flex;
    align-items: center;
    gap: 13rpx;
    padding: 11rpx 0;
    font-size: 25rpx;
}

.check-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    color: #ffffff;
    background: #14b8a6;
    font-size: 20rpx;
}

.owner-note {
    margin-top: 16rpx;
    padding: 18rpx;
    border-radius: 16rpx;
    color: #6b7280;
    background: #f7f5f2;
    font-size: 22rpx;
    line-height: 1.55;
}

.checkin-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 30rpx;
    text-align: center;
}

.checkin-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    color: #0d9488;
    background: #f0fdfa;
    font-size: 48rpx;
}

.checkin-title {
    margin-top: 20rpx;
    font-size: 29rpx;
    font-weight: 800;
}

.checkin-desc {
    max-width: 520rpx;
    margin-top: 9rpx;
    line-height: 1.5;
}

.checkin-button {
    width: 320rpx;
    margin-top: 25rpx;
}

.evidence-upload {
    padding: 22rpx;
}

.photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14rpx;
}

.photo-cell {
    position: relative;
}

.upload-photo {
    width: 100%;
    height: 245rpx;
    border-radius: 18rpx;
    background: #f3f4f6;
}

.remove-photo {
    position: absolute;
    top: 8rpx;
    right: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42rpx;
    height: 42rpx;
    border-radius: 50%;
    color: #ffffff;
    background: rgba(17, 24, 39, 0.68);
    font-size: 28rpx;
}

.add-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7rpx;
    height: 245rpx;
    border: 2rpx dashed #99f6e4;
    border-radius: 18rpx;
    background: #f0fdfa;
}

.add-photo-plus {
    color: #0d9488;
    font-size: 50rpx;
    line-height: 1;
}

.upload-tip {
    margin-top: 15rpx;
    line-height: 1.45;
}

.complete-button {
    margin-top: 22rpx;
}

.waiting-box {
    margin-top: 20rpx;
    padding: 22rpx;
    border-radius: 18rpx;
    background: #fef3c7;
    text-align: center;
}

.waiting-title {
    margin-bottom: 6rpx;
    color: #92400e;
    font-size: 26rpx;
    font-weight: 800;
}

.tip-card {
    margin: 24rpx 8rpx;
    color: #9ca3af;
    font-size: 20rpx;
    line-height: 1.55;
}
