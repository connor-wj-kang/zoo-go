.task-page {
    padding-top: 20rpx;
}

.summary-card {
    display: flex;
    gap: 20rpx;
}

.summary-img {
    width: 128rpx;
    height: 128rpx;
    flex-shrink: 0;
    border-radius: 26rpx;
}

.summary-main {
    min-width: 0;
}

.summary-name {
    max-width: 330rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 29rpx;
    font-weight: 800;
}

.summary-line {
    margin-top: 7rpx;
    color: #6b7280;
    font-size: 22rpx;
}

.summary-services {
    margin-top: 9rpx;
    font-size: 22rpx;
    line-height: 1.45;
}

.bidding-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 28rpx;
    padding: 22rpx 28rpx;
    border-radius: 24rpx;
    color: #ffffff;
    background: linear-gradient(100deg, #f97316, #f59e0b);
    font-size: 24rpx;
}

.banner-left {
    display: flex;
    align-items: center;
    gap: 9rpx;
    font-weight: 700;
}

.flame {
    font-size: 28rpx;
}

.banner-time {
    font-family: Menlo, monospace;
    font-size: 31rpx;
    font-weight: 800;
}

.bid-section {
    margin-top: 28rpx;
}

.bid-list {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.bid-head {
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.bid-person {
    min-width: 0;
}

.bid-name-row {
    gap: 10rpx;
}

.star {
    color: #fbbf24;
}

.bid-price-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.bid-price {
    color: #ea580c;
    font-size: 38rpx;
    font-weight: 900;
}

.lowest-tag {
    color: #0d9488;
    font-size: 19rpx;
}

.bid-message {
    margin-top: 18rpx;
    padding: 16rpx 18rpx;
    border-radius: 16rpx;
    color: #6b7280;
    background: #f7f5f2;
    font-size: 22rpx;
    line-height: 1.5;
}

.pick-button {
    min-height: 72rpx;
    margin-top: 20rpx;
    font-size: 25rpx;
}

.no-bid {
    padding: 60rpx 20rpx;
}

.student-view-button {
    width: 300rpx;
    min-height: 72rpx;
    margin: 28rpx auto 0;
    font-size: 24rpx;
}

.cancel-link {
    width: 100%;
    margin-top: 28rpx;
    color: #6b7280;
    font-size: 22rpx;
    text-decoration: underline;
}

.payment-card {
    position: relative;
}

.winner-row {
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.pay-amount {
    color: #ea580c;
    font-size: 40rpx;
    font-weight: 900;
}

.countdown-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 22rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    color: #92400e;
    background: #fef3c7;
    font-size: 22rpx;
}

.countdown-value {
    font-family: Menlo, monospace;
    font-size: 31rpx;
    font-weight: 800;
}

.pay-note {
    margin-top: 13rpx;
    line-height: 1.5;
}

.pay-button {
    margin-top: 24rpx;
    min-height: 82rpx;
    font-size: 27rpx;
}

.reopen-button {
    margin-top: 16rpx;
    min-height: 78rpx;
    font-size: 25rpx;
}

.info-row {
    display: flex;
    justify-content: space-between;
    gap: 28rpx;
    padding: 14rpx 0;
    font-size: 26rpx;
}

.sheet-tip {
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    color: #92400e;
    background: #fef3c7;
    font-size: 22rpx;
    line-height: 1.55;
}

.sheet-submit {
    margin-top: 30rpx;
}
