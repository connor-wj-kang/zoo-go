.order-page {
    padding-top: 22rpx;
}

.order-heading {
    display: flex;
    align-items: flex-start;
    gap: 18rpx;
    padding: 4rpx 4rpx 22rpx;
}

.order-title {
    font-size: 36rpx;
    font-weight: 900;
}

.order-subtitle {
    margin-top: 6rpx;
}

.timeline-card {
    padding: 28rpx 20rpx 24rpx;
}

.timeline {
    display: flex;
    align-items: flex-start;
    flex: 1;
}

.timeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
    width: 96rpx;
}

.step-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50rpx;
    height: 50rpx;
    border-radius: 50%;
    color: #9ca3af;
    background: #f3f4f6;
    font-size: 21rpx;
    font-weight: 800;
}

.step-dot-done {
    color: #ffffff;
    background: #f97316;
}

.step-dot-current {
    box-shadow: 0 0 0 7rpx rgba(249, 115, 22, 0.14);
}

.step-label {
    color: #6b7280;
    font-size: 20rpx;
}

.step-label-done {
    color: #1f2937;
    font-weight: 700;
}

.step-line {
    flex: 1;
    height: 4rpx;
    margin-top: 23rpx;
    background: #e5e7eb;
}

.step-line-done {
    background: #fb923c;
}

.student-card {
    margin-top: 22rpx;
}

.student-row {
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.student-name {
    gap: 9rpx;
}

.call-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    color: #0d9488;
    background: #f0fdfa;
    font-size: 30rpx;
}

.refund-card {
    margin-top: 22rpx;
    padding-top: 24rpx;
    padding-bottom: 24rpx;
}

.refund-head {
    margin-bottom: 10rpx;
}

.refund-note {
    margin-top: 14rpx;
    line-height: 1.5;
}

.address-box {
    margin-top: 22rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    background: #f7f5f2;
}

.address-title {
    gap: 8rpx;
    font-size: 25rpx;
}

.address-note {
    margin-top: 6rpx;
    padding-left: 30rpx;
}

.service-hint {
    margin-top: 18rpx;
    color: #0f766e;
    font-size: 22rpx;
}

.evidence-card {
    padding: 20rpx;
}

.photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
}

.evidence-photo {
    width: 100%;
    height: 196rpx;
    border-radius: 18rpx;
    background: #f3f4f6;
}

.evidence-note {
    margin-top: 15rpx;
}

.info-card {
    padding-top: 16rpx;
    padding-bottom: 16rpx;
}

.info-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30rpx;
    padding: 13rpx 0;
    font-size: 25rpx;
}

.info-value {
    max-width: 410rpx;
    text-align: right;
}

.checklist-line {
    align-items: flex-start;
}

.checklist {
    max-width: 410rpx;
    padding: 2rpx 0 0 16rpx;
    color: #374151;
    font-size: 23rpx;
    line-height: 1.6;
}

.note-box {
    margin-top: 14rpx;
    padding: 18rpx;
    border-radius: 16rpx;
    color: #6b7280;
    background: #f7f5f2;
    font-size: 22rpx;
    line-height: 1.55;
}

.fee-card {
    padding-top: 16rpx;
    padding-bottom: 16rpx;
}

.total-line {
    padding-top: 18rpx;
    font-size: 27rpx;
}

.fee-note {
    margin-top: 8rpx;
    line-height: 1.45;
}

.action-section {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
    padding-bottom: 20rpx;
}

.support-button {
    min-height: 78rpx;
    font-size: 25rpx;
}

.rated-box {
    padding: 28rpx;
    border-radius: 22rpx;
    color: #92400e;
    background: #fef3c7;
    text-align: center;
    font-size: 25rpx;
    font-weight: 700;
}

.rating-tip {
    color: #6b7280;
    font-size: 23rpx;
    line-height: 1.55;
}

.star-row {
    display: flex;
    justify-content: center;
    gap: 18rpx;
    margin-top: 30rpx;
}

.star-choice {
    color: #d1d5db;
    font-size: 70rpx;
}

.star-active {
    color: #fbbf24;
}

.rating-value {
    margin-top: 10rpx;
    text-align: center;
    color: #6b7280;
    font-size: 24rpx;
}

.rating-submit {
    margin-top: 30rpx;
}
