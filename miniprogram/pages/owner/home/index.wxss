.home-page {
    padding-top: 18rpx;
}

.error-card {
    margin-top: 24rpx;
}

.error-text {
    margin-top: 12rpx;
}

.retry-btn {
    margin-top: 24rpx;
}

.area-row {
    display: flex;
    align-items: center;
    gap: 9rpx;
    color: #6b7280;
    font-size: 23rpx;
}

.pin {
    color: #f97316;
    font-size: 27rpx;
    font-weight: 700;
}

.area-open {
    margin-left: 4rpx;
    padding: 5rpx 15rpx;
    border-radius: 999rpx;
    color: #0f766e;
    background: #f0fdfa;
    font-size: 20rpx;
    font-weight: 700;
}

.hero {
    position: relative;
    margin-top: 20rpx;
    height: 330rpx;
    overflow: hidden;
    border-radius: 40rpx;
    background: linear-gradient(135deg, #f97316, #f59e0b);
    box-shadow: 0 22rpx 50rpx rgba(249, 115, 22, 0.24);
}

.hero-img {
    position: absolute;
    top: -20rpx;
    right: -88rpx;
    width: 360rpx;
    height: 360rpx;
    border-radius: 50%;
    opacity: 0.72;
}

.hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(234, 88, 12, 0.96), rgba(249, 115, 22, 0.76) 62%, rgba(245, 158, 11, 0.2));
}

.hero-content {
    position: relative;
    z-index: 2;
    padding: 46rpx 38rpx;
    color: #ffffff;
}

.hero-kicker {
    font-size: 22rpx;
    opacity: 0.82;
}

.hero-title {
    width: 390rpx;
    margin-top: 12rpx;
    font-size: 42rpx;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: 1rpx;
}

.hero-button {
    display: inline-flex;
    align-items: center;
    gap: 8rpx;
    margin-top: 30rpx;
    padding: 20rpx 32rpx;
    border-radius: 999rpx;
    color: #ea580c;
    background: #ffffff;
    font-size: 26rpx;
    font-weight: 800;
    box-shadow: 0 10rpx 24rpx rgba(124, 45, 18, 0.18);
}

.hero-plus {
    font-size: 30rpx;
    font-weight: 500;
}

.community-bar {
    display: flex;
    align-items: center;
    gap: 18rpx;
    margin-top: 22rpx;
    padding: 22rpx 24rpx;
    border: 1rpx solid #ccfbf1;
    border-radius: 28rpx;
    background: linear-gradient(110deg, #ffffff, #f0fdfa);
    box-shadow: 0 10rpx 24rpx rgba(13, 148, 136, 0.08);
}

.community-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70rpx;
    height: 70rpx;
    flex-shrink: 0;
    border-radius: 22rpx;
    color: #ffffff;
    background: linear-gradient(135deg, #14b8a6, #0f766e);
    font-size: 34rpx;
    font-weight: 800;
}

.community-title-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.community-title {
    font-size: 27rpx;
    font-weight: 800;
}

.community-count {
    color: #0f766e;
    font-size: 19rpx;
}

.community-latest {
    max-width: 400rpx;
    margin-top: 6rpx;
    overflow: hidden;
    color: #6b7280;
    font-size: 21rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.community-action {
    flex-shrink: 0;
    padding: 12rpx 20rpx;
    border-radius: 999rpx;
    color: #ffffff;
    background: #0f766e;
    font-size: 21rpx;
    font-weight: 700;
}

.steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12rpx;
    margin-top: 24rpx;
}

.step-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 20rpx 8rpx;
    border-radius: 24rpx;
    background: #ffffff;
    border: 1rpx solid rgba(229, 231, 235, 0.7);
    text-align: center;
}

.step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 66rpx;
    height: 66rpx;
    margin-bottom: 10rpx;
    border-radius: 50%;
    color: #ea580c;
    background: #fff7ed;
    font-size: 30rpx;
    font-weight: 800;
}

.step-title {
    width: 100%;
    font-size: 21rpx;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.step-desc {
    margin-top: 3rpx;
    color: #6b7280;
    font-size: 18rpx;
    line-height: 1.3;
}

.task-stack {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.task-card {
    display: flex;
    gap: 20rpx;
    padding: 24rpx;
}

.task-main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.task-name {
    max-width: 330rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 28rpx;
    font-weight: 800;
}

.task-time {
    margin-top: 8rpx;
    color: #6b7280;
    font-size: 22rpx;
}

.task-foot {
    margin-top: 14rpx;
}

.task-price {
    font-size: 25rpx;
}

.bid-count {
    color: #0d9488;
    font-size: 22rpx;
    font-weight: 600;
}

.pet-scroll {
    width: calc(100% + 56rpx);
    margin-left: -28rpx;
    white-space: nowrap;
}

.pet-row {
    display: inline-flex;
    gap: 18rpx;
    padding: 0 28rpx 4rpx;
}

.pet-card {
    display: flex;
    width: 420rpx;
    padding: 20rpx;
    gap: 18rpx;
}

.pet-card-img {
    width: 112rpx;
    height: 112rpx;
    flex-shrink: 0;
    border-radius: 24rpx;
}

.flag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6rpx;
    margin-top: 10rpx;
}

.flag {
    padding: 3rpx 11rpx;
    border-radius: 8rpx;
    color: #b45309;
    background: #fffbeb;
    font-size: 18rpx;
}

.add-pet {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
    width: 170rpx;
    border: 2rpx dashed #fdba74;
    border-radius: 30rpx;
    color: #ea580c;
    background: rgba(255, 247, 237, 0.62);
    font-size: 22rpx;
}

.add-plus {
    font-size: 38rpx;
    line-height: 1;
}

.guarantee-card {
    padding: 0 28rpx;
}

.guarantee-item {
    display: flex;
    align-items: center;
    gap: 22rpx;
    padding: 25rpx 0;
    border-bottom: 1rpx solid rgba(229, 231, 235, 0.68);
}

.guarantee-item:last-child {
    border-bottom: 0;
}

.guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 62rpx;
    height: 62rpx;
    flex-shrink: 0;
    border-radius: 19rpx;
    color: #0d9488;
    background: #f0fdfa;
    font-size: 28rpx;
    font-weight: 800;
}

.guarantee-title {
    font-size: 26rpx;
    font-weight: 700;
}

.student-entry {
    display: flex;
    align-items: center;
    gap: 22rpx;
    margin-top: 34rpx;
    padding: 28rpx;
    border-radius: 30rpx;
    color: #ffffff;
    background: linear-gradient(100deg, #14b8a6, #0f766e);
    box-shadow: 0 14rpx 30rpx rgba(13, 148, 136, 0.22);
}

.student-entry-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 62rpx;
    height: 62rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    font-size: 34rpx;
}

.student-entry-desc {
    margin-top: 5rpx;
    color: rgba(255, 255, 255, 0.78);
}
