.community-page {
    padding-top: 20rpx;
}

.community-hero {
    padding: 34rpx 32rpx;
    border-radius: 34rpx;
    color: #ffffff;
    background: linear-gradient(125deg, #0f766e, #14b8a6 62%, #5eead4);
    box-shadow: 0 18rpx 42rpx rgba(13, 148, 136, 0.2);
}

.hero-kicker {
    font-size: 21rpx;
    opacity: 0.8;
}

.hero-title {
    margin-top: 10rpx;
    font-size: 38rpx;
    font-weight: 900;
    line-height: 1.3;
}

.composer {
    margin-top: 22rpx;
}

.composer-input {
    width: 100%;
    min-height: 150rpx;
    font-size: 27rpx;
    line-height: 1.65;
}

.selected-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
    margin-top: 18rpx;
}

.selected-item {
    position: relative;
    height: 190rpx;
}

.selected-image {
    width: 100%;
    height: 100%;
    border-radius: 18rpx;
    background: #f3f4f6;
}

.remove-image {
    position: absolute;
    top: -10rpx;
    right: -10rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42rpx;
    height: 42rpx;
    border: 4rpx solid #ffffff;
    border-radius: 50%;
    color: #ffffff;
    background: rgba(17, 24, 39, 0.78);
    font-size: 28rpx;
}

.composer-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 1rpx solid #f0f1f3;
}

.image-picker {
    display: flex;
    align-items: center;
    gap: 7rpx;
    color: #0f766e;
    font-size: 23rpx;
    font-weight: 600;
}

.image-picker-icon {
    font-size: 31rpx;
}

.publish-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 190rpx;
    height: 72rpx;
    padding: 0 26rpx;
    border-radius: 999rpx;
    color: #ffffff;
    background: linear-gradient(100deg, #14b8a6, #0f766e);
    font-size: 24rpx;
    font-weight: 800;
}

.publish-button[disabled] {
    opacity: 0.42;
}

.feed-head {
    margin-top: 34rpx;
}

.post-list {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.post-card {
    padding: 25rpx;
}

.author-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.author-avatar {
    width: 76rpx;
    height: 76rpx;
    flex-shrink: 0;
    border-radius: 50%;
    background: #f3f4f6;
}

.author-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: linear-gradient(135deg, #fb923c, #ea580c);
    font-size: 29rpx;
    font-weight: 800;
}

.author-name-row {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.author-name {
    font-size: 26rpx;
    font-weight: 800;
}

.mine-badge {
    padding: 2rpx 9rpx;
    border-radius: 7rpx;
    color: #c2410c;
    background: #fff7ed;
    font-size: 17rpx;
}

.post-time {
    margin-top: 5rpx;
}

.post-content {
    display: block;
    margin-top: 20rpx;
    color: #374151;
    font-size: 27rpx;
    line-height: 1.72;
    white-space: pre-wrap;
    word-break: break-all;
}

.post-images {
    display: grid;
    gap: 9rpx;
    margin-top: 19rpx;
}

.post-images-1 {
    grid-template-columns: 1fr;
}

.post-images-2,
.post-images-4 {
    grid-template-columns: 1fr 1fr;
}

.post-images-3,
.post-images-5,
.post-images-6,
.post-images-7,
.post-images-8,
.post-images-9 {
    grid-template-columns: repeat(3, 1fr);
}

.post-image {
    width: 100%;
    height: 205rpx;
    border-radius: 16rpx;
    background: #f3f4f6;
}

.post-images-1 .post-image {
    height: 370rpx;
}

.post-images-2 .post-image,
.post-images-4 .post-image {
    height: 250rpx;
}

.load-more {
    width: 260rpx;
    min-height: 72rpx;
    margin: 26rpx auto 0;
    border-radius: 999rpx;
    color: #0f766e;
    background: #f0fdfa;
    font-size: 24rpx;
    font-weight: 700;
}

.feed-end {
    padding: 30rpx 0 16rpx;
    color: #9ca3af;
    font-size: 21rpx;
    text-align: center;
}

.retry-button {
    width: 250rpx;
    min-height: 70rpx;
    margin: 24rpx auto 0;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 90rpx 0;
}

.empty-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 126rpx;
    height: 126rpx;
    margin-bottom: 20rpx;
    border-radius: 50%;
    color: #0f766e;
    background: #ffffff;
    font-size: 52rpx;
}

.empty-state .tiny {
    margin-top: 8rpx;
}
