<view class="tabbar">
    <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{active === item.key ? 'tab-active' : ''}}"
        data-url="{{item.url}}"
        data-key="{{item.key}}"
        bindtap="onTap"
    >
        <text class="tab-icon">{{item.icon}}</text>
        <text class="tab-label">{{item.label}}</text>
    </view>
</view>
<view class="tabbar-space"></view>
