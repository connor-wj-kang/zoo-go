.nav-shell {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18rpx);
    border-bottom: 1rpx solid rgba(229, 231, 235, 0.65);
}

.nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    height: 92rpx;
    padding: 0 210rpx 0 28rpx;
}

.nav-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60rpx;
    height: 60rpx;
    margin-left: -10rpx;
    border-radius: 50%;
    font-size: 52rpx;
    color: #1f2937;
    line-height: 50rpx;
}

.nav-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #1f2937;
}

.nav-title-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 31rpx;
    font-weight: 700;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 10rpx;
    margin-left: auto;
}

.nav-right-icon {
    font-size: 34rpx;
    color: #374151;
}

.nav-right-text {
    font-size: 25rpx;
    color: #ea580c;
}
