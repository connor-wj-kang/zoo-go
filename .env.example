WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=secrets/wechat-pay/wechatpay_public_key.pem
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/v1/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=https://api.example.com/v1/refunds/wechat/notify
DEV_AUTH=false
ADMIN_TOKEN=
ADDR=:8080
DATA_FILE=data/zoo.db
UPLOAD_DIR=data/uploads
ADMIN_DIR=admin

# OpenObserve (self-hosted on the same machine)
O2_USER=root@example.com
O2_PASS=Complexpass#123
O2_PORT=5080

# OTLP -> OpenObserve (set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry)
# Generate headers with:
#   printf '%s' "$O2_USER:$O2_PASS" | base64 -w0
# then: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<that-value>
OTEL_SERVICE_NAME=zoo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
