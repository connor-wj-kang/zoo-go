# Copy to deploy/.env on the ECS host and fill in real values.
# Never commit deploy/.env.

ZOO_IMAGE=ghcr.io/connor-wj-kang/zoo-go:latest
API_PORT=8080

# Leave WeChat pay fields empty until fully configured; any non-empty
# pay field enables payment init and will fail startup if incomplete.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

DEV_AUTH=false
ADMIN_TOKEN=

O2_USER=root@example.com
O2_PASS=change-me
O2_PORT=5080

OTEL_SERVICE_NAME=zoo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# printf '%s' "$O2_USER:$O2_PASS" | base64 -w0
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REPLACE_ME
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
